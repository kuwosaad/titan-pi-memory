#!/bin/sh
# Run Grok commands using the Python environment installed with this plugin.
SOURCE=$0
while [ -L "$SOURCE" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
set -e
TITAN_PY=$(python3 "$SCRIPT_DIR/titan_plugin_runtime.py" --runtime-python)
exec "$TITAN_PY" -Es "$SCRIPT_DIR/titan_grok_tools.py" "$@"
