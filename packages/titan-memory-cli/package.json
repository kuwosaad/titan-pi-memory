{
  "name": "titan-memory-cli",
  "version": "0.1.4",
  "description": "Titan Memory CLI and local-first memory runtime for coding agents",
  "keywords": [
    "memory",
    "codex",
    "mcp",
    "agent-memory",
    "persistent-memory",
    "coding-agent"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuwosaad/titan-pi-memory.git"
  },
  "homepage": "https://github.com/kuwosaad/titan-pi-memory#readme",
  "bugs": {
    "url": "https://github.com/kuwosaad/titan-pi-memory/issues"
  },
  "bin": {
    "titan": "bin/titan.js",
    "titan-memory-cli": "bin/titan.js"
  },
  "files": [
    "bin/",
    "runtime/",
    "!runtime/**/__pycache__/**",
    "!runtime/**/*.pyc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node scripts/prepare-runtime.js && node scripts/audit-runtime.js && python ../../scripts/package_gate.py --pack",
    "release:check": "python ../../scripts/package_gate.py --source",
    "release:verify": "python ../../scripts/verify_packed_artifact.py --root ../..",
    "test": "node bin/titan.js codex list-tools --json && python -m pytest ../../tests/test_release_artifact.py -q"
  },
  "engines": {
    "node": ">=18"
  }
}
