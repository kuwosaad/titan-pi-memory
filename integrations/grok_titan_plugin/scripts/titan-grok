#!/bin/sh
# Wrapper so Grok can call Pi-parity Titan tools as `titan-grok`.
SOURCE=$0
while [ -L "$SOURCE" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
TITAN_PY="${TITAN_PYTHON:-$HOME/.local/pipx/venvs/titan-memory-cli/bin/python}"
if [ ! -x "$TITAN_PY" ]; then
  TITAN_PY="python3"
fi
exec "$TITAN_PY" "$SCRIPT_DIR/titan_grok_tools.py" "$@"
