{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/titan_claude_hook.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/titan_claude_hook.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/titan_claude_hook.py"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/titan_claude_hook.py"
            ]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 3,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/titan_claude_hook.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/titan_claude_hook.py"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/titan_claude_hook.py"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "timeout": 2,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/titan_claude_hook.py"
            ]
          }
        ]
      }
    ]
  }
}
